# ==============================================================================
# Belintan Freelance Platform — Production Environment Configuration
# Canonical Domain: https://ProfileBelintan.com/
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=production

# Database (Optional - Defaults to atomic data/portfolio-store.json fallback)
DATABASE_URL=postgresql://belintan_user:belintan_secure_pass_2026@localhost:5432/belintan_crm

# Google Gemini API
# Get your key from: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Meta WhatsApp Business Cloud API
# Get from Meta for Developers: https://developers.facebook.com/
WHATSAPP_VERIFY_TOKEN=belintan_secure_webhook_token_2026
WHATSAPP_ACCESS_TOKEN=YOUR_META_GRAPH_ACCESS_TOKEN
WHATSAPP_PHONE_ID=YOUR_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_NOTIFY_NUMBER=918610662871

# WebRTC & Telephony Configuration
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=
